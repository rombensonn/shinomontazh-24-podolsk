# Public site URL for metadata, canonical links and sitemap generation.
# Use the real production domain after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite storage. For VPS deployment, keep this path writable by the Node.js process.
SQLITE_DB_PATH=./data/leads.sqlite

# Used to sign the form-start timestamp for minimum-fill-time spam protection.
LEAD_FORM_SECRET=change-me-on-production

# Telegram Bot API. If empty, leads are still saved to SQLite and the form stays usable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP email copy. All fields below are optional; email is skipped if required values are absent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=

# Optional SMS provider adapter placeholder. Fill these only after choosing a provider.
SMS_PROVIDER_ENDPOINT=
SMS_PROVIDER_API_KEY=
SMS_TO_PHONE=
